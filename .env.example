# ============================================================================
# Vaultspec agent-to-agent (A2A) orchestrator environment variables
#
# WHERE THESE BELONG. A setting is read from the process environment, or from
# the operator's own settings file — the one named by VAULTSPEC_A2A_ENV_FILE,
# resolved against the project root. Nothing discovers that file: name it, or
# it is not read, and naming one that is not there is an error rather than a
# silent fall back to defaults.
#
# The project's own .env is NOT that file. It arrives with a clone, so it
# supplies no setting at all. Exactly these credentials are read from it, one
# name at a time, and only when the running interpreter belongs to that project
# and the project runs vaultspec-a2a as a dependency or dev dependency:
#
#   VAULTSPEC_A2A_OPENAI_API_KEY / OPENAI_API_KEY
#   VAULTSPEC_A2A_ZHIPU_API_KEY / ZHIPU_API_KEY
#   VAULTSPEC_A2A_ZAI_AUTH_TOKEN / ZAI_AUTH_TOKEN / ZAI_API_KEY
#   VAULTSPEC_A2A_KIMI_MODEL_API_KEY / KIMI_MODEL_API_KEY
#   VAULTSPEC_A2A_INTERNAL_TOKEN
#   VAULTSPEC_A2A_GATEWAY_TOKEN
#
# NAME THE FILE. Copy this file to the settings file you name, and fill values
# as needed. Starting the service outside `just`, name it on the process:
#
#   VAULTSPEC_A2A_ENV_FILE=.env vaultspec-a2a serve
#
# An absolute path works the same way, and a relative one is resolved against
# the project root rather than the launch directory. Under `just`, the recipes
# that run the service name this checkout's .env for you, so a developer who
# keeps settings there needs no extra step.
# Required: needed for the described feature.
# Optional: has a default.
# Abbreviations: ACP = Agent Client Protocol; API = application programming
# interface; CI = continuous integration;
# HTTP = Hypertext Transfer Protocol; IPC = interprocess communication;
# LLM = large language model; MCP = Model
# Context Protocol; OTel = OpenTelemetry; OTLP = OpenTelemetry Protocol;
# SDK = software development kit; SSE = server-sent events;
# UI = user interface; URL = uniform resource locator.

# Port layout
# Native process ports. Development Compose publishes Jaeger and VidaiMock only.
#
#   Port   Service          Env Var                     Notes
#   ----   -------          -------                     -----
#   18000  Gateway API      VAULTSPEC_A2A_PORT              HTTP + SSE
#   18001  Worker           VAULTSPEC_A2A_WORKER_PORT       LangGraph executor
#   4317   Jaeger OTLP      JAEGER_OTLP_PORT             Integration loopback collector
#   16686  Jaeger UI        JAEGER_UI_PORT               Loopback trace viewer
#   13133  Jaeger health    (not configurable)          Health check endpoint
#   5432   PostgreSQL       (embedded in DATABASE_URL)  Only when backend=postgres
#   8100   VidaiMock        VAULTSPEC_A2A_MOCK_API_BASE               Integration profile

# LangSmith tracing
# READ FROM THE PROCESS ENVIRONMENT, NOT FROM THIS FILE. These four names are
# consumed by the langsmith SDK directly; the service has no setting for them and
# cannot switch tracing on or off. A settings file is read into the Settings
# object, never into the environment, so a value set only in one never reaches
# the SDK. Export them in the real environment if you want tracing.
# Required for tracing and evaluations.
LANGSMITH_API_KEY=
# The SDK accepts the exact string "true" and nothing else; "1" and "yes" leave
# tracing off. LANGCHAIN_TRACING_V2 is honoured as an equivalent name.
# Keep tracing disabled unless you deliberately want to send traces to the
# configured LangSmith project.
LANGSMITH_TRACING=false
# Optional: trace grouping name.
LANGSMITH_PROJECT=vaultspec-dev
# Optional: self-hosted endpoint.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Provider API keys
# Configure credentials only for providers you intend to execute.
# Every provider name in this section is another tool's own spelling. Each is
# also read under an a2a name that wins when both are set, so a value can be
# scoped to this service alone: VAULTSPEC_A2A_OPENAI_API_KEY, VAULTSPEC_A2A_OPENAI_BASE_URL,
# VAULTSPEC_A2A_ZHIPU_API_KEY, VAULTSPEC_A2A_ZAI_AUTH_TOKEN,
# VAULTSPEC_A2A_ZAI_BASE_URL, VAULTSPEC_A2A_KIMI_CODE_HOME,
# VAULTSPEC_A2A_KIMI_MODEL_NAME, VAULTSPEC_A2A_KIMI_MODEL_API_KEY,
# VAULTSPEC_A2A_KIMI_MODEL_BASE_URL, VAULTSPEC_A2A_KIMI_MODEL_MAX_CONTEXT_SIZE,
# VAULTSPEC_A2A_KIMI_MODEL_CAPABILITIES, VAULTSPEC_A2A_ANTIGRAVITY_CLI_PATH,
# VAULTSPEC_A2A_ANTIGRAVITY_CLI_HOME and VAULTSPEC_A2A_CODEX_HOME.
# The default Claude channel uses the CLI's own session (`claude login`). The
# CLI also accepts an operator-exported CLAUDE_CODE_OAUTH_TOKEN inherited by
# the service process. A token only in this project .env authenticates nothing
# under that default channel: this file is not the child process environment.
# To inject a configured token, explicitly select oauth_token and set the
# canonical token name below. A blank token under oauth_token refuses the lane.
# The foreign CLAUDE_CODE_OAUTH_TOKEN name is also a settings alias, but the
# repository's recipes may export it into the process environment as well.
# ANTHROPIC_API_KEY is deliberately absent: it is stripped from every agent
# subprocess (alongside an OAuth session it downgrades a flat-rate subscription
# to pay-as-you-go).
# VAULTSPEC_A2A_CLAUDE_AUTH_CHANNEL=subscription_login
# VAULTSPEC_A2A_CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# Catalog discovery and execution always use this same lane endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
ZHIPU_API_KEY=
# Z.ai drives the ACP lane against an Anthropic-compatible endpoint. It is a
# DIFFERENT provider lane from ZHIPU_API_KEY above, with its own readiness gate:
# configuring one does not enable the other. ZAI_API_KEY is honoured as an
# equivalent name for this token.
ZAI_AUTH_TOKEN=
# Optional: retarget the Z.ai endpoint; default shown.
# ZAI_ANTHROPIC_BASE_URL is honoured as an equivalent name.
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# Kimi Code reads persisted provider/model aliases from ~/.kimi-code by default.
# Set KIMI_CODE_HOME to use another persisted configuration directory.
# KIMI_CODE_HOME=
# A temporary provider requires all three current names together. Ambient Kimi
# model variables are scrubbed; the service re-injects only this complete tuple
# and selects the exact served alias separately with `-m`.
KIMI_MODEL_NAME=
KIMI_MODEL_API_KEY=
KIMI_MODEL_BASE_URL=
# Optional provider-owned attributes are preserved only with a complete tuple.
# Context size is a positive integer (maximum 2147483647). Capabilities are a
# comma-separated ordered list of bounded provider tokens; whitespace and exact
# duplicates are normalized before the installed CLI receives them.
KIMI_MODEL_MAX_CONTEXT_SIZE=
KIMI_MODEL_CAPABILITIES=
# Antigravity ships its `agy` CLI OUTSIDE PATH (a per-user application
# directory reached through a wrapper), so a bare name lookup finds nothing on a
# machine where the CLI works. Point this at the executable to override the
# lane's PATH-then-installer-default resolution.
# ANTIGRAVITY_CLI_PATH=
# Where the Antigravity CLI keeps its own login. Optional: the lane falls back
# to the installer's default location.
# ANTIGRAVITY_CLI_HOME=
# Codex authenticates from a persisted local session in its Codex home
# (~/.codex by default) — no API key is involved. Optional: point the subprocess
# at an alternate home for headless or container use.
# CODEX_HOME=
# Codex web-search posture, written into the per-run config home:
# disabled | cached | indexed | live. Unset uses the served default. A
# deployment preferring zero egress sets "cached" — a genuine search against a
# provider-maintained index with no outbound request from the agent host.
# This preference sits ABOVE the lane-admission gate: it can narrow a proven
# lane's reach, never grant reach to an unproven one.
# VAULTSPEC_A2A_CODEX_WEB_SEARCH_MODE=
# Point the Codex lane at an alternate API endpoint. Unset in every served
# deployment, and it should stay that way: Codex resolves its endpoint from its
# config home rather than the environment, so this is the only seam that can
# redirect the lane at all. It exists so a provider REFUSAL can be driven on
# demand — a lane that only ever succeeds cannot demonstrate what it reports
# when a provider turns work away.
# VAULTSPEC_A2A_CODEX_BASE_URL=

# Server configuration
# Loopback by default. Binding a host process to every interface exposes the
# API beyond this machine.
VAULTSPEC_A2A_HOST=127.0.0.1
VAULTSPEC_A2A_PORT=18000
# development | staging | production
# Internal gateway<->worker IPC auth is DISABLED whenever VAULTSPEC_A2A_INTERNAL_TOKEN
# is unset AND this is "development" — a deliberate local-dev convenience, not a
# gap in any shipped deployment. Copying this file for a staging/production
# deployment: set this to "staging" or "production" AND set
# VAULTSPEC_A2A_INTERNAL_TOKEN below, or every internal gateway<->worker call fails
# with a 500 "configuration error" at request time (VAULTSPEC_A2A_INTERNAL_TOKEN
# required outside development).
VAULTSPEC_A2A_ENVIRONMENT=development
VAULTSPEC_A2A_LOG_LEVEL=info
# Persistence backend — ADR-035: SQLite is the local/dev default.
# For production, set postgres + a postgresql+asyncpg:// URL.
VAULTSPEC_A2A_DATABASE_BACKEND=sqlite
VAULTSPEC_A2A_CHECKPOINT_BACKEND=sqlite
# SQLite store location. Left unset, the application database and the checkpoint
# store are state/vaultspec.db and state/checkpoints.db inside the state home
# (VAULTSPEC_A2A_HOME below). A relative SQLite path resolves against the project
# root, never the working directory, so every process of one project opens the
# same file wherever it was launched. Setting it also moves the checkpoint store
# into the same file unless VAULTSPEC_A2A_CHECKPOINT_DATABASE_URL is set too.
# VAULTSPEC_A2A_DATABASE_URL=sqlite+aiosqlite:///data/vaultspec.db
# Uncomment for Postgres production: the whole block below, replacing the two
# backend lines above. The backend and the URL are cross-validated, so moving
# one store to Postgres without the other is refused at startup. The checkpoint
# URL is optional and defaults to VAULTSPEC_A2A_DATABASE_URL.
# Name a driver in each URL. A bare postgresql:// scheme leaves SQLAlchemy to
# pick its default synchronous driver, psycopg2, which this project does not
# ship - and the destructive `db clear` command builds a synchronous engine
# from the primary URL. The checkpoint store is driven by psycopg (v3) on every
# path it takes, which is why it names a different driver than the primary URL:
# the LangGraph saver and the admin engine both speak psycopg, never asyncpg.
# VAULTSPEC_A2A_DATABASE_BACKEND=postgres
# VAULTSPEC_A2A_CHECKPOINT_BACKEND=postgres
# VAULTSPEC_A2A_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/vaultspec
# VAULTSPEC_A2A_CHECKPOINT_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/vaultspec?sslmode=disable
# Workspace label for this process. Unset by default: agent working directories
# come from each run's own workspace_root. A relative value resolves against the
# project root.
# VAULTSPEC_A2A_WORKSPACE_ROOT=
# Optional external execution identity launcher. Leave unset for desktop
# profiles: configuring this alone does not establish native OS isolation.
# When configured, all three identity settings must be present and valid.
# VAULTSPEC_A2A_PROVIDER_IDENTITY_LAUNCHER=
# VAULTSPEC_A2A_PROVIDER_AGENT_UID=
# VAULTSPEC_A2A_PROVIDER_AGENT_GID=
# Install root: where this service's shipped assets (the ACP adapter's
# node_modules) live. Computed from the package; override only for non-editable
# native installs. Never a storage location.
# VAULTSPEC_A2A_INSTALL_ROOT=
# Explicit Claude CLI for Claude and Z.ai. Supply an absolute path on the
# service host; when set, it outranks a desktop capsule's bundled CLI.
# VAULTSPEC_A2A_CLAUDE_CLI_EXECUTABLE=
# Project root: the project a2a serves and keeps its state under. Unset, it is
# the nearest ancestor of the working directory holding .vaultspec/ or .vault/,
# then one holding .git, else the working directory. Read from the process
# environment only - this file is found through it, so it cannot set it.
# VAULTSPEC_A2A_PROJECT_ROOT=
# ACP gateway backend: node (default, uses npm-installed index.js via Node.js)
# or binary (uses the precompiled Bun executable in src/vaultspec_a2a/bin/).
# node is the stable default per ADR-002 §5.1. binary mode is experimental —
# requires placing claude-agent-acp binary in src/vaultspec_a2a/bin/ first.
VAULTSPEC_A2A_ACP_BACKEND=node
# Global timeout (seconds) for LLM provider API calls.
VAULTSPEC_A2A_PROVIDER_TIMEOUT_SECONDS=120


# Gateway URL
# Base URL for reaching the gateway HTTP API (used by worker IPC and the CLI).
# Derived from VAULTSPEC_A2A_HOST + VAULTSPEC_A2A_PORT when not set, which is
# the value shown. Set it only for a remote gateway or a proxy; it also supplies
# the spawned worker's heartbeat and pairing target, so a proxy here redirects
# worker-to-gateway pairing too.
# VAULTSPEC_A2A_GATEWAY_URL=http://127.0.0.1:18000

# Worker process
VAULTSPEC_A2A_WORKER_PORT=18001
VAULTSPEC_A2A_WORKER_HOST=127.0.0.1
# Auto-derived from VAULTSPEC_A2A_WORKER_HOST + VAULTSPEC_A2A_WORKER_PORT when not set.
# VAULTSPEC_A2A_WORKER_URL=http://127.0.0.1:18001
# Required outside VAULTSPEC_A2A_ENVIRONMENT=development (see the note above it) to
# protect internal gateway<->worker control calls. Left unset here for local
# development. Production runs as native binaries.
VAULTSPEC_A2A_INTERNAL_TOKEN=
VAULTSPEC_A2A_MAX_CONCURRENT_THREADS=5
# Thread listing reads checkpoints in bounded parallel batches under a deadline.
# VAULTSPEC_A2A_THREAD_LIST_CHECKPOINT_CONCURRENCY=8
# VAULTSPEC_A2A_THREAD_LIST_CHECKPOINT_DEADLINE_SECONDS=5.0
# Seconds an admitted-but-unstarted run keeps its reservation.
# VAULTSPEC_A2A_ADMISSION_RESERVATION_TTL_SECONDS=120
# Budget for the provider catalog build a run start waits on.
# VAULTSPEC_A2A_RUN_START_CATALOG_BUDGET_SECONDS=120
# Seconds an ingest may go without a new event before it is treated as stalled.
# VAULTSPEC_A2A_INGEST_EVENT_STALL_TIMEOUT_SECONDS=90
# One absolute shutdown budget, and the part of it spent draining open streams.
# VAULTSPEC_A2A_SHUTDOWN_TOTAL_TIMEOUT_SECONDS=15.0
# VAULTSPEC_A2A_SHUTDOWN_STREAM_GRACE_SECONDS=2
VAULTSPEC_A2A_AUTO_SPAWN_WORKER=true
VAULTSPEC_A2A_POSTGRES_REQUIRED=false
VAULTSPEC_A2A_SQLITE_BUSY_TIMEOUT_MS=5000
# SQLAlchemy connection pool (Postgres only)
VAULTSPEC_A2A_DB_POOL_SIZE=5
VAULTSPEC_A2A_DB_POOL_MAX_OVERFLOW=10

# Operational tuning (optional; defaults shown)
# Worker / circuit-breaker
# VAULTSPEC_A2A_WORKER_HEARTBEAT_TIMEOUT_SECONDS=90.0
# VAULTSPEC_A2A_CB_FAILURE_THRESHOLD=3
# VAULTSPEC_A2A_CB_RECOVERY_TIMEOUT_SECONDS=30.0
# Worker health-poll back-off
# VAULTSPEC_A2A_WORKER_POLL_INITIAL_INTERVAL_SECONDS=0.1
# VAULTSPEC_A2A_WORKER_POLL_MAX_INTERVAL_SECONDS=2.0
# VAULTSPEC_A2A_WORKER_POLL_BACKOFF_FACTOR=1.5
# VAULTSPEC_A2A_WORKER_POLL_LOG_INTERVAL_SECONDS=5.0
# How long a spawned worker may take to become ready before the spawn is
# abandoned and its whole process tree reaped. Raise for slow cold starts.
# VAULTSPEC_A2A_WORKER_READY_TIMEOUT_SECONDS=30.0
# Worker watchdog
# VAULTSPEC_A2A_WATCHDOG_POLL_INTERVAL_SECONDS=5.0
# VAULTSPEC_A2A_WATCHDOG_MAX_RETRIES=3
# VAULTSPEC_A2A_WATCHDOG_BACKOFF_BASE_SECONDS=2.0
# Progress stream
# VAULTSPEC_A2A_STREAM_HEARTBEAT_INTERVAL_SECONDS=30.0
# Retain a bounded per-run window of outgoing progress frames so a
# disconnected viewer can resume. Off, no frame carries an SSE id at all.
# VAULTSPEC_A2A_STREAM_REPLAY_ENABLED=true
# Rows retained per run in the replay log; also the furthest back a resume
# can reach.
# VAULTSPEC_A2A_STREAM_REPLAY_WINDOW_EVENTS=2000
# Hours a replay row survives: rows produced longer ago, and rows of runs that
# settled longer ago, are swept. Independent of checkpoint retention.
# VAULTSPEC_A2A_STREAM_REPLAY_RETENTION_HOURS=24.0
# Internal IPC
# VAULTSPEC_A2A_INTERNAL_MAX_HTTP_BODY_BYTES=1048576
# VAULTSPEC_A2A_INTERNAL_EVENT_BATCH_BODY_MULTIPLIER=4
# VAULTSPEC_A2A_IPC_FLUSH_INTERVAL_SECONDS=0.05
# VAULTSPEC_A2A_IPC_MAX_FLUSH_RETRIES=3
# VAULTSPEC_A2A_IPC_RETRY_BACKOFF_BASE_SECONDS=0.1
# VAULTSPEC_A2A_IPC_MAX_EVENT_BUFFER=10000
# LangGraph / executor
# VAULTSPEC_A2A_GRAPH_RECURSION_LIMIT=100
# VAULTSPEC_A2A_MAX_CACHED_GRAPHS=32
# Event aggregator
# VAULTSPEC_A2A_TOOL_CALL_DEBOUNCE_SECONDS=0.1
# VAULTSPEC_A2A_PLAN_UPDATE_DEBOUNCE_SECONDS=0.25
# VAULTSPEC_A2A_CHUNK_FLUSH_INTERVAL_SECONDS=0.05
# VAULTSPEC_A2A_DEBOUNCE_MAP_MAX_ENTRIES=1000
# VAULTSPEC_A2A_CHUNK_BUFFER_MAX_BYTES=4096
# VAULTSPEC_A2A_TOOL_ARG_TRUNCATE_LEN=1000
# VAULTSPEC_A2A_EVENT_QUEUE_MAXSIZE=512
# Per-client subscription cap. VAULTSPEC_A2A_MAX_STREAM_CONNECTIONS bounds how many
# stream clients exist; this bounds the fan-out work each one can demand, since
# every subscription is matched against every broadcast event. Set 0 to disable.
# VAULTSPEC_A2A_MAX_SUBSCRIPTIONS_PER_CLIENT=512
# VAULTSPEC_A2A_AGET_STATE_TIMEOUT_SECONDS=10.0
# VAULTSPEC_A2A_SUPERVISOR_REASK_LIMIT=2
# Consecutive FINISH decisions a completion gate may block and reroute in one
# turn before the run fails. Separate from the re-ask budget: a blocked FINISH
# runs a worker that can satisfy the gate, so it costs a worker turn too.
# VAULTSPEC_A2A_SUPERVISOR_FINISH_BLOCK_LIMIT=3
# Run continuation
# Continuations one busy run may hold waiting behind its in-flight turn, and
# how many may wait across the whole service. Exceeding either is a typed
# refusal to the caller, never a silent drop.
# VAULTSPEC_A2A_RUN_CONTINUATION_QUEUE_DEPTH=1
# VAULTSPEC_A2A_RUN_CONTINUATION_SERVICE_QUEUE_CAP=64
# Maximum predecessor user and assistant messages seeded into a successor run.
# VAULTSPEC_A2A_SUCCESSOR_TRANSCRIPT_DEPTH=20
# Total lifetime of one run, from its creation and across every turn a
# continuation adds. A continuation offered past this bound is refused and the
# run settles with the terminal its last turn reached.
# VAULTSPEC_A2A_MAX_RUN_LIFETIME_SECONDS=86400
# Context / workspace sizing
# VAULTSPEC_A2A_CONTEXT_LIMIT_TOKENS=120000
# VAULTSPEC_A2A_CHARS_PER_TOKEN=4
# VAULTSPEC_A2A_ANCHOR_PATH_CAP=10
# VAULTSPEC_A2A_MAX_CONTEXT_REFS=50
# VAULTSPEC_A2A_VAULT_INDEX_CAP=50
# VAULTSPEC_A2A_MOUNT_TOKEN_CEILING=20000
# VAULTSPEC_A2A_MIN_REMAINING_TOKENS_FOR_MOUNT=100
# ACP provider
# VAULTSPEC_A2A_ACP_STARTUP_TIMEOUT_SECONDS=300.0
# VAULTSPEC_A2A_ACP_FS_READ_MAX_BYTES=10485760
# VAULTSPEC_A2A_ACP_RPC_TIMEOUT_SECONDS=15.0
# VAULTSPEC_A2A_ACP_CHUNK_QUEUE_MAXSIZE=1024
# VAULTSPEC_A2A_ACP_INTERACTIVE_AUTH_TIMEOUT_SECONDS=900.0
# Backstop on a turn whose agent is alive but has stopped emitting frames. The
# clock resets on every frame, so a working agent never trips it. Set 0 to disable.
# VAULTSPEC_A2A_ACP_TURN_IDLE_TIMEOUT_SECONDS=600.0

# OpenTelemetry (OTel)
# Used by telemetry instrumentation. Each OTEL_* name below is the standard one;
# the a2a names VAULTSPEC_A2A_OTEL_EXPORTER_OTLP_ENDPOINT,
# VAULTSPEC_A2A_OTEL_EXPORTER_OTLP_INSECURE, VAULTSPEC_A2A_OTEL_SERVICE_NAME,
# VAULTSPEC_A2A_OTEL_SERVICE_VERSION, VAULTSPEC_A2A_OTEL_SDK_DISABLED,
# VAULTSPEC_A2A_OTEL_EXPORTER_CONSOLE, VAULTSPEC_A2A_OTEL_TRACES_EXPORTER and
# VAULTSPEC_A2A_OTEL_METRICS_EXPORTER win over them for this service alone.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Optional: service identity.
# OTEL_SERVICE_NAME=vaultspec-a2a
# OTEL_SERVICE_VERSION=0.1.0
# Optional: disable the SDK or log spans to standard output.
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_CONSOLE=true
# Optional: "none" builds no span exporter / no metric reader at all.
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none

# Mock LLM (Docker development)
# Base URL for the mock LLM server (VidaiMock)
# VAULTSPEC_A2A_MOCK_API_BASE=http://127.0.0.1:8100

# CI and output flags
# Both bare names are shared with every other tool on the machine. Each also
# honours a VAULTSPEC_-prefixed spelling — VAULTSPEC_A2A_CI and VAULTSPEC_A2A_NO_COLOR —
# for setting the flag for this service alone.
# CI=true
# NO_COLOR=true

# State home
# Everything a2a writes: state/ (databases), runtime/ (logs), service.json and
# service.token (discovery and its handoff credential), procs/ (process registry
# and leases), tmp/homes/ (per-run provider homes). Defaults to .vault/data/agents
# in the project root - vaultspec's own runtime subtree, which it ignores and never
# walks. A relative value resolves against the project root; nothing is written
# to the user profile or the system temporary directory.
# VAULTSPEC_A2A_HOME=.vault/data/agents

# Development process registry
# Directory holding the registry of dev processes, their port reservations and
# the test-resource leases.
# VAULTSPEC_A2A_PROCS_HOME=
# The managed-process table. Unset: procs.toml in the project root.
# VAULTSPEC_A2A_PROCS_TOML=
# Owner label stamped on registry records this process claims.
# VAULTSPEC_A2A_PROCS_OWNER=
# Written by the registry into a managed child; not set by hand.
# VAULTSPEC_A2A_PROCS_NAME=
# Command template the registry serves the engine with ({port}, {workspace}).
# VAULTSPEC_A2A_ENGINE_SERVE_CMD=vaultspec serve --no-seat --port {port}

# Engine discovery
# The vaultspec engine's discovery record a2a attaches through.
# Must be a private versioned engine record outside repositories; legacy records
# are refused. Default: ~/.vaultspec-engine/discovery/<project-key>/service.json.
# VAULTSPEC_A2A_ENGINE_SERVICE_JSON=

# Provider lanes
# Serve the in-process provider lanes (deterministic and mock). Off by default.
# VAULTSPEC_A2A_SERVE_IN_PROCESS_LANES=false
# Keep each run's generated Codex config home for inspection.
# VAULTSPEC_A2A_CODEX_CONFIG_HOME_RETAIN=false

# Written by the gateway into its worker's environment; never set by hand.
# VAULTSPEC_A2A_GATEWAY_LIFETIME_ID=
# VAULTSPEC_A2A_WORKER_GENERATION=

# Engine-facing gateway credential
# Optional: the bearer an attaching engine presents to the authenticated v1
# surface. Left unset, the gateway mints a random one per application generation
# and publishes it through the owner-restricted handoff file beside the discovery
# record - never in the record itself. Set it only to pin a known value.
# VAULTSPEC_A2A_GATEWAY_TOKEN=

# Request access logging
# Optional: emit a per-request access line. Off by default because the gateway is
# polled continuously by design (worker heartbeat, health probes), so the access
# drip buries diagnostics. OTel spans carry request tracing; enable this for a
# raw access trail when no collector is available.
VAULTSPEC_A2A_ACCESS_LOG=false

# Authoring subscriber
# Consumes the engine's authoring event stream. Required for the document
# authoring lane; the live certification lanes will not run without it.
VAULTSPEC_A2A_AUTHORING_SUBSCRIBER_ENABLED=false
# Optional: seconds between polls of the engine event cursor.
# VAULTSPEC_A2A_AUTHORING_SUBSCRIBER_POLL_INTERVAL_SECONDS=3.0
# Optional: first reconnect backoff after the engine stream drops.
# VAULTSPEC_A2A_AUTHORING_SUBSCRIBER_RECONNECT_BASE_SECONDS=2.0
# Optional: ceiling for the reconnect backoff.
# VAULTSPEC_A2A_AUTHORING_SUBSCRIBER_RECONNECT_MAX_SECONDS=30.0

# Worker watchdog
# Optional: minimum seconds between watchdog-initiated worker restarts, so a
# worker that fails at boot cannot be restarted in a tight loop.
# VAULTSPEC_A2A_WATCHDOG_RESTART_COOLDOWN_SECONDS=30.0

# Deliberately absent: VAULTSPEC_A2A_DESKTOP_APP_HOME, VAULTSPEC_A2A_CAPSULE_ASSETS
# and VAULTSPEC_A2A_DESKTOP_SETTLEMENT_URL. All three belong to the packaged
# desktop profile, whose launcher (the dashboard) sets them; none is meaningful
# for an unseated development process. A test
# pins this exclusion so a future setting cannot go undocumented by accident.

# Progress-stream connection limit
# Optional: maximum concurrent progress-stream subscribers the gateway admits.
# Each holds a bounded queue and a delivery path, so an unbounded count is a
# resource-exhaustion surface even for an authenticated caller. Zero disables the
# limit (a deliberate operator choice). Default 256.
# VAULTSPEC_A2A_MAX_STREAM_CONNECTIONS=256

# ---------------------------------------------------------------------------
# Native launch handoff (generated internally; never configure these):
# VAULTSPEC_A2A_NATIVE_PACKET_COUNT and numbered chunks beginning with
# VAULTSPEC_A2A_NATIVE_PACKET_0 carry the bounded launch environment to the
# native bootstrap decoder. These are private process-protocol fields, not settings.

# Development harness
# Read by this repository's own tooling under dev/ and by its test suite, never
# by the service. Leave them unset for ordinary use.
# ---------------------------------------------------------------------------
# Optional: directory for machine-readable CI reports (JUnit XML, audit JSON).
# VAULTSPEC_A2A_CI_REPORTS=.tmp-reports
# Optional: report file name for one test lane, so two lanes in a job differ.
# VAULTSPEC_A2A_CI_REPORT_NAME=unit
# Optional: make the fix recipes exit 5 when they had to change something.
# VAULTSPEC_A2A_FIX_STRICT=1
# Optional: let a lane that legitimately collects nothing pass.
# VAULTSPEC_A2A_ALLOW_EMPTY_SELECTION=1
# Optional: stream `just init` progress as NDJSON events.
# VAULTSPEC_A2A_INIT_JSON=1
# Optional: make `just init` ignore its stamp and run every phase.
# VAULTSPEC_A2A_INIT_FORCE=1
# Optional: CPU budget the test admission plans concurrent sessions against.
# VAULTSPEC_A2A_TEST_CPU_BUDGET=8
# Optional: the live provider lane a billable proof turn runs on. The ids are
# catalog-derived; print the block with `just test-lanes --exports
# <provider>=<model>` instead of typing it.
# VAULTSPEC_A2A_LIVE_PROVIDER_ID=
# VAULTSPEC_A2A_LIVE_EXECUTION_MODE=
# VAULTSPEC_A2A_LIVE_ENTRY_ID=
# VAULTSPEC_A2A_LIVE_CONTROL_ID=
# VAULTSPEC_A2A_LIVE_OPTION_ID=
# Optional: a second lane, for a mixed-provider proof that routes one role to
# a lane different from the first.
# VAULTSPEC_A2A_LIVE_OVERRIDE_PROVIDER_ID=
# VAULTSPEC_A2A_LIVE_OVERRIDE_EXECUTION_MODE=
# VAULTSPEC_A2A_LIVE_OVERRIDE_ENTRY_ID=
# VAULTSPEC_A2A_LIVE_OVERRIDE_CONTROL_ID=
# VAULTSPEC_A2A_LIVE_OVERRIDE_OPTION_ID=
# Set by the harness for its own child processes, never by hand:
# VAULTSPEC_A2A_TEST_SESSION_ROOT, VAULTSPEC_A2A_TEST_SESSION_PID,
# VAULTSPEC_A2A_TEST_SEATED_HOME, VAULTSPEC_A2A_TEST_SEATED_PROCS_HOME,
# VAULTSPEC_A2A_TEST_COMPLETION_ENDPOINT and
# VAULTSPEC_A2A_TEST_COMPLETION_OWNER_PID.
