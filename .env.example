# ============================================================================
# Vaultspec agent-to-agent (A2A) orchestrator environment variables
# Copy this file to the repository-root .env and fill values as needed.
# Required: needed for the described feature.
# Optional: has a default.
# Abbreviations: ACP = Agent Client Protocol; API = application programming
# interface; CI = continuous integration; CORS = cross-origin resource sharing;
# HTTP = Hypertext Transfer Protocol; IPC = interprocess communication;
# LLM = large language model; MCP = Model
# Context Protocol; OTel = OpenTelemetry; OTLP = OpenTelemetry Protocol;
# REST = representational state transfer; SDK = software development kit;
# UI = user interface; URL = uniform resource locator.

# Port layout
# Default process ports. Docker Compose (Compose) publishes only the ports
# declared by each profile; the worker remains internal to the Compose network.
#
#   Port   Service          Env Var                     Notes
#   ----   -------          -------                     -----
#   18000  Gateway API      VAULTSPEC_PORT              REST + WebSocket
#   18001  Worker           VAULTSPEC_WORKER_PORT       LangGraph executor
#   8200   MCP server       VAULTSPEC_MCP_PORT          Streamable HTTP transport
#   4317   Jaeger OTLP      OTEL_EXPORTER_OTLP_ENDPOINT Trace collector
#   16686  Jaeger UI        (not configurable)          Trace viewer
#   13133  Jaeger health    (not configurable)          Health check endpoint
#   5432   PostgreSQL       (embedded in DATABASE_URL)  Only when backend=postgres
#   8100   VidaiMock        MOCK_API_BASE               Integration profile
#
# Warning: the MCP server (:8200) and VidaiMock (:8100) use different
# default ports. If you change either, update the corresponding env var.

# LangSmith tracing
# READ FROM THE PROCESS ENVIRONMENT, NOT FROM THIS FILE. These four names are
# consumed by the langsmith SDK directly; the service has no setting for them and
# cannot switch tracing on or off. This file is loaded into the Settings object,
# never into the environment, so a value set only here reaches the SDK only when
# the launcher exports it first — `just` does (dotenv-load), a packaged or
# containerised process does not. Export them in the real environment if you want
# tracing anywhere but a `just` recipe.
# Required for tracing and evaluations.
LANGSMITH_API_KEY=
# The SDK accepts the exact string "true" and nothing else; "1" and "yes" leave
# tracing off. LANGCHAIN_TRACING_V2 is honoured as an equivalent name.
# Keep tracing disabled unless you deliberately want to send traces to the
# configured LangSmith project.
LANGSMITH_TRACING=false
# Optional: trace grouping name.
LANGSMITH_PROJECT=vaultspec-dev
# Optional: self-hosted endpoint.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Provider API keys
# Configure credentials only for providers you intend to execute.
# ANTHROPIC_API_KEY is deliberately absent: the Claude lane authenticates with
# CLAUDE_CODE_OAUTH_TOKEN, and the name is actively stripped from every agent
# subprocess (setting both downgrades a flat-rate subscription to pay-as-you-go).
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# Catalog discovery and execution always use this same lane endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
ZHIPU_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Z.ai drives the ACP lane against an Anthropic-compatible endpoint. It is a
# DIFFERENT provider lane from ZHIPU_API_KEY above, with its own readiness gate:
# configuring one does not enable the other. ZAI_API_KEY is honoured as an
# equivalent name for this token.
ZAI_AUTH_TOKEN=
# Optional: retarget the Z.ai endpoint; default shown.
# ZAI_ANTHROPIC_BASE_URL is honoured as an equivalent name.
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# Kimi Code reads persisted provider/model aliases from ~/.kimi-code by default.
# Set KIMI_CODE_HOME to use another persisted configuration directory.
# KIMI_CODE_HOME=
# A temporary provider requires all three current names together. Ambient Kimi
# model variables are scrubbed; the service re-injects only this complete tuple
# and selects the exact served alias separately with `-m`.
KIMI_MODEL_NAME=
KIMI_MODEL_API_KEY=
KIMI_MODEL_BASE_URL=
# Legacy aliases remain accepted after the current names for migration only.
# KIMI_API_KEY=
# KIMI_BASE_URL=
# Google Cloud / Vertex AI (optional — for Gemini via Vertex)
# The service reads only the two names below and injects them into the Gemini
# subprocess. GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION are not settings and
# are not injected; set them in the real environment if the Gemini CLI needs them.
# GOOGLE_APPLICATION_CREDENTIALS=
# GEMINI_CLI_HOME=
# Codex authenticates from a persisted local session in its Codex home
# (~/.codex by default) — no API key is involved. Optional: point the subprocess
# at an alternate home for headless or container use.
# CODEX_HOME=
# Codex web-search posture, written into the per-run config home:
# disabled | cached | indexed | live. Unset uses the served default. A
# deployment preferring zero egress sets "cached" — a genuine search against a
# provider-maintained index with no outbound request from the agent host.
# This preference sits ABOVE the lane-admission gate: it can narrow a proven
# lane's reach, never grant reach to an unproven one.
# VAULTSPEC_CODEX_WEB_SEARCH_MODE=

# Server configuration
VAULTSPEC_HOST=0.0.0.0
VAULTSPEC_PORT=18000
# development | staging | production
VAULTSPEC_ENVIRONMENT=development
VAULTSPEC_LOG_LEVEL=info
# Persistence backend — ADR-035: SQLite is the local/dev default.
# For production, set postgres + a postgresql+asyncpg:// URL.
VAULTSPEC_DATABASE_BACKEND=sqlite
VAULTSPEC_CHECKPOINT_BACKEND=sqlite
VAULTSPEC_DATABASE_URL=sqlite+aiosqlite:///vaultspec.db
# Required when using docker-compose.prod.postgres.yml
POSTGRES_PASSWORD=
# Dedicated checkpoint DB (optional — defaults to VAULTSPEC_DATABASE_URL).
# Uncomment for Postgres production:
# VAULTSPEC_DATABASE_BACKEND=postgres
# VAULTSPEC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/vaultspec
# VAULTSPEC_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vaultspec?sslmode=disable
VAULTSPEC_WORKSPACE_ROOT=./workspaces
# Override the computed project path for non-editable container installs.
# VAULTSPEC_PROJECT_ROOT=/app
# ACP gateway backend: node (default, uses npm-installed index.js via Node.js)
# or binary (uses the precompiled Bun executable in src/vaultspec_a2a/bin/).
# node is the stable default per ADR-002 §5.1. binary mode is experimental —
# requires placing claude-agent-acp binary in src/vaultspec_a2a/bin/ first.
VAULTSPEC_ACP_BACKEND=node
# ACP-ENV-006: suppress interactive feedback survey and telemetry traffic in
# non-interactive ACP subprocess sessions. Both are injected unconditionally
# by the provider; these entries document the effective runtime values.
CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Global timeout (seconds) for LLM provider API calls.
VAULTSPEC_PROVIDER_TIMEOUT_SECONDS=120


# Gateway URL
# Base URL for reaching the gateway HTTP API (used by worker IPC + MCP tools).
# Auto-derived from VAULTSPEC_HOST + VAULTSPEC_PORT when not set.
# Only set explicitly for remote gateways or proxy setups.
# VAULTSPEC_GATEWAY_URL=http://localhost:18000
# Bind host/port for MCP streamable-http transport
VAULTSPEC_MCP_HOST=0.0.0.0
VAULTSPEC_MCP_PORT=8200
# DNS-rebinding protection for the MCP streamable-http transport.
# The Host and Origin values the server will accept; anything else is refused
# with 421 / 403 before MCP handling. The defaults admit loopback only, which
# is what a local IDE client sends. Binding VAULTSPEC_MCP_HOST to a non-loopback
# address does NOT widen these — front the server under a real hostname and you
# must name that hostname here, or every request is refused.
# Comma-separated. A ":*" suffix matches any port.
VAULTSPEC_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
VAULTSPEC_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# VAULTSPEC_MCP_API_BASE_URL is an alternate spelling of VAULTSPEC_GATEWAY_URL,
# NOT an MCP-only override: both names set the same single gateway URL, which
# also supplies the spawned worker's heartbeat and pairing target. Pointing this
# at a proxy therefore redirects worker-to-gateway pairing as well as MCP.
# There is no MCP-scoped gateway URL; prefer VAULTSPEC_GATEWAY_URL for clarity.
# VAULTSPEC_MCP_API_BASE_URL=http://localhost:18000

# Worker process
VAULTSPEC_WORKER_PORT=18001
VAULTSPEC_WORKER_HOST=127.0.0.1
# Auto-derived from VAULTSPEC_WORKER_HOST + VAULTSPEC_WORKER_PORT when not set.
# VAULTSPEC_WORKER_URL=http://127.0.0.1:18001
# Set in production to protect internal control calls
VAULTSPEC_INTERNAL_TOKEN=
VAULTSPEC_MAX_CONCURRENT_THREADS=5
VAULTSPEC_AUTO_SPAWN_WORKER=true
VAULTSPEC_REPAIR_ON_STARTUP=true
# conservative | mark_repair_needed
VAULTSPEC_REPAIR_STRATEGY=conservative
VAULTSPEC_POSTGRES_REQUIRED=false
VAULTSPEC_SQLITE_BUSY_TIMEOUT_MS=5000
# SQLAlchemy connection pool (Postgres only)
VAULTSPEC_DB_POOL_SIZE=5
VAULTSPEC_DB_POOL_MAX_OVERFLOW=10

# Operational tuning (optional; defaults shown)
# Worker / circuit-breaker
# VAULTSPEC_WORKER_HEARTBEAT_TIMEOUT_SECONDS=90.0
# VAULTSPEC_CB_FAILURE_THRESHOLD=3
# VAULTSPEC_CB_RECOVERY_TIMEOUT_SECONDS=30.0
# Worker health-poll back-off
# VAULTSPEC_WORKER_POLL_INITIAL_INTERVAL_SECONDS=0.1
# VAULTSPEC_WORKER_POLL_MAX_INTERVAL_SECONDS=2.0
# VAULTSPEC_WORKER_POLL_BACKOFF_FACTOR=1.5
# VAULTSPEC_WORKER_POLL_LOG_INTERVAL_SECONDS=5.0
# How long a spawned worker may take to become ready before the spawn is
# abandoned and its whole process tree reaped. Raise for slow cold starts.
# VAULTSPEC_WORKER_READY_TIMEOUT_SECONDS=30.0
# Worker watchdog
# VAULTSPEC_WATCHDOG_POLL_INTERVAL_SECONDS=5.0
# VAULTSPEC_WATCHDOG_MAX_RETRIES=3
# VAULTSPEC_WATCHDOG_BACKOFF_BASE_SECONDS=2.0
# Progress stream
# VAULTSPEC_STREAM_HEARTBEAT_INTERVAL_SECONDS=30.0
# Internal IPC
# VAULTSPEC_INTERNAL_MAX_FRAME_BYTES=1048576
# VAULTSPEC_INTERNAL_MAX_HTTP_BODY_BYTES=1048576
# VAULTSPEC_IPC_FLUSH_INTERVAL_SECONDS=0.05
# VAULTSPEC_IPC_MAX_FLUSH_RETRIES=3
# VAULTSPEC_IPC_RETRY_BACKOFF_BASE_SECONDS=0.1
# VAULTSPEC_IPC_MAX_EVENT_BUFFER=10000
# LangGraph / executor
# VAULTSPEC_GRAPH_RECURSION_LIMIT=100
# VAULTSPEC_MAX_CACHED_GRAPHS=32
# Event aggregator
# VAULTSPEC_TOOL_CALL_DEBOUNCE_SECONDS=0.1
# VAULTSPEC_PLAN_UPDATE_DEBOUNCE_SECONDS=0.25
# VAULTSPEC_CHUNK_FLUSH_INTERVAL_SECONDS=0.05
# VAULTSPEC_DEBOUNCE_MAP_MAX_ENTRIES=1000
# VAULTSPEC_CHUNK_BUFFER_MAX_BYTES=4096
# VAULTSPEC_TOOL_ARG_TRUNCATE_LEN=1000
# VAULTSPEC_EVENT_QUEUE_MAXSIZE=512
# Per-client subscription cap. VAULTSPEC_MAX_STREAM_CONNECTIONS bounds how many
# stream clients exist; this bounds the fan-out work each one can demand, since
# every subscription is matched against every broadcast event. Set 0 to disable.
# VAULTSPEC_MAX_SUBSCRIPTIONS_PER_CLIENT=512
# VAULTSPEC_AGET_STATE_TIMEOUT_SECONDS=10.0
# Context / workspace sizing
# VAULTSPEC_CONTEXT_LIMIT_TOKENS=120000
# VAULTSPEC_CHARS_PER_TOKEN=4
# VAULTSPEC_ANCHOR_PATH_CAP=10
# VAULTSPEC_MAX_CONTEXT_REFS=50
# VAULTSPEC_VAULT_INDEX_CAP=50
# VAULTSPEC_MOUNT_TOKEN_CEILING=20000
# VAULTSPEC_MIN_REMAINING_TOKENS_FOR_MOUNT=100
# VAULTSPEC_TASK_QUEUE_PENDING_HORIZON=2
# ACP provider
# VAULTSPEC_ACP_STARTUP_TIMEOUT_SECONDS=300.0
# VAULTSPEC_ACP_FS_READ_MAX_BYTES=10485760
# VAULTSPEC_ACP_RPC_TIMEOUT_SECONDS=15.0
# VAULTSPEC_ACP_CHUNK_QUEUE_MAXSIZE=1024
# VAULTSPEC_ACP_INTERACTIVE_AUTH_TIMEOUT_SECONDS=900.0
# Backstop on a turn whose agent is alive but has stopped emitting frames. The
# clock resets on every frame, so a working agent never trips it. Set 0 to disable.
# VAULTSPEC_ACP_TURN_IDLE_TIMEOUT_SECONDS=600.0
# Gemini OAuth
# VAULTSPEC_OAUTH_EXPIRY_BUFFER_SECONDS=120
# MCP server
# VAULTSPEC_MCP_CREATE_TIMEOUT_SECONDS=30.0
# VAULTSPEC_MCP_QUERY_TIMEOUT_SECONDS=15.0
# VAULTSPEC_MCP_MAX_INITIAL_MESSAGE_CHARS=32000
# VAULTSPEC_MCP_PREVIEW_TRUNCATE_LEN=200

# OpenTelemetry (OTel)
# Used by telemetry instrumentation.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Optional: service identity.
# OTEL_SERVICE_NAME=vaultspec-a2a
# OTEL_SERVICE_VERSION=0.1.0
# Optional: disable the SDK or log spans to standard output.
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_CONSOLE=true

# Mock LLM (Docker development)
# Base URL for the mock LLM server (VidaiMock)
# MOCK_API_BASE=http://vidaimock:8100

# CI and output flags
# Both bare names are shared with every other tool on the machine. Each also
# honours a VAULTSPEC_-prefixed spelling — VAULTSPEC_CI and VAULTSPEC_NO_COLOR —
# for setting the flag for this service alone.
# CI=true
# NO_COLOR=true

# Runtime state home
# Optional: machine-global directory holding the discovery record, its handoff
# credential, and runtime logs. Deliberately outside the vault, which rejects
# foreign directories. Defaults to ~/.vaultspec-a2a.
# VAULTSPEC_A2A_HOME=

# Engine-facing gateway credential
# Optional: the bearer an attaching engine presents to the authenticated v1
# surface. Left unset, the gateway mints a random one per application generation
# and publishes it through the owner-restricted handoff file beside the discovery
# record - never in the record itself. Set it only to pin a known value.
# VAULTSPEC_A2A_GATEWAY_TOKEN=

# Request access logging
# Optional: emit a per-request access line. Off by default because the gateway is
# polled continuously by design (worker heartbeat, health probes), so the access
# drip buries diagnostics. OTel spans carry request tracing; enable this for a
# raw access trail when no collector is available.
VAULTSPEC_ACCESS_LOG=false

# Authoring subscriber
# Consumes the engine's authoring event stream. Required for the document
# authoring lane; the live certification lanes will not run without it.
VAULTSPEC_AUTHORING_SUBSCRIBER_ENABLED=false
# Optional: seconds between polls of the engine event cursor.
# VAULTSPEC_AUTHORING_SUBSCRIBER_POLL_INTERVAL_SECONDS=3.0
# Optional: first reconnect backoff after the engine stream drops.
# VAULTSPEC_AUTHORING_SUBSCRIBER_RECONNECT_BASE_SECONDS=2.0
# Optional: ceiling for the reconnect backoff.
# VAULTSPEC_AUTHORING_SUBSCRIBER_RECONNECT_MAX_SECONDS=30.0

# Worker watchdog
# Optional: minimum seconds between watchdog-initiated worker restarts, so a
# worker that fails at boot cannot be restarted in a tight loop.
# VAULTSPEC_WATCHDOG_RESTART_COOLDOWN_SECONDS=30.0

# Deliberately absent: VAULTSPEC_DESKTOP_APP_HOME and VAULTSPEC_CAPSULE_ASSETS.
# Both belong to the packaged desktop profile, which seats its own state root and
# capsule assets; neither is meaningful for a Compose service deployment. A test
# pins this exclusion so a future setting cannot go undocumented by accident.

# Progress-stream connection limit
# Optional: maximum concurrent progress-stream subscribers the gateway admits.
# Each holds a bounded queue and a delivery path, so an unbounded count is a
# resource-exhaustion surface even for an authenticated caller. Zero disables the
# limit (a deliberate operator choice). Default 256.
# VAULTSPEC_MAX_STREAM_CONNECTIONS=256
