# ============================================================================
# Vaultspec A2A Orchestrator — Integration Test Environment Variables
# ============================================================================
# Copy to the settings file VAULTSPEC_A2A_ENV_FILE names, or export these in
# the process environment, and fill values as needed for integration tests.
# Starting the service outside `just`, name the file on the process:
#
#   VAULTSPEC_A2A_ENV_FILE=.env.integration vaultspec-a2a serve
#
# An absolute path works the same way, and a relative one is resolved against
# the project root rather than the launch directory. The project's own .env
# supplies no setting: it is read only for the credentials listed in
# .env.example, and only under the install-mode gate described there.

# -- Database ------------------------------------------------------------------
# VAULTSPEC_A2A_DATABASE_URL=sqlite+aiosqlite:///test.sqlite

# -- Gateway -------------------------------------------------------------------
# VAULTSPEC_A2A_HOST=127.0.0.1
# VAULTSPEC_A2A_PORT=18000

# -- CI / Output Flags --------------------------------------------------------
# CI=true
# NO_COLOR=true
