# Auto-detect text files and normalise line endings (LF in repo, native on checkout)
* text=auto eol=lf

# ── Source code ──────────────────────────────────────────────────────
*.py        text diff=python
*.js        text
*.mjs       text
*.html      text
*.md        text diff=markdown
*.yaml      text
*.yml       text
*.toml      text
*.json      text
*.svg       text

# ── Config / dotfiles ───────────────────────────────────────────────
*.gitignore      text
*.gitattributes  text
*.dockerignore   text
*.npmrc          text
*.geminiignore   text
.python-version  text
Dockerfile       text
Justfile         text

# ── Lock files (exact byte-for-byte) ────────────────────────────────
*.lock      text -diff linguist-generated

# >>> vaultspec-managed (do not edit this block) >>>
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
.vault/exec/**/*-ledger.md merge=union
# <<< vaultspec-managed <<<

# ── Binary files (never normalise) ──────────────────────────────────
*.zip       binary
*.db        binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
