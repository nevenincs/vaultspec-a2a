{
  "$defs": {
    "ComponentEntrypoints": {
      "additionalProperties": false,
      "description": "The dashboard-owned gateway launch and the caller-owned MCP launch.",
      "properties": {
        "gateway": {
          "$ref": "#/$defs/GatewayEntrypoint",
          "description": "Dashboard-owned desktop gateway launch entrypoint."
        },
        "standalone_mcp": {
          "$ref": "#/$defs/StandaloneMcpEntrypoint",
          "description": "Caller-owned standalone vaultspec-a2a-mcp entrypoint."
        }
      },
      "required": [
        "gateway",
        "standalone_mcp"
      ],
      "title": "ComponentEntrypoints",
      "type": "object"
    },
    "ComponentIdentity": {
      "additionalProperties": false,
      "description": "The component's distribution name and its own version.",
      "properties": {
        "name": {
          "description": "Distribution name.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "description": "Component (A2A distribution) version string.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ComponentIdentity",
      "type": "object"
    },
    "GatewayEntrypoint": {
      "additionalProperties": false,
      "description": "The dashboard-owned gateway launch surface.",
      "properties": {
        "kind": {
          "const": "gateway",
          "description": "The gateway launch-surface discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "console_script": {
          "description": "Console-script name declared by the distribution.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Console Script",
          "type": "string"
        },
        "reference": {
          "description": "Entry-point object reference, e.g. 'pkg.module:main'.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "relative_command": {
          "description": "Bounded argv path segments relative to the runtime root.",
          "items": {
            "description": "One portable, non-rooted runtime path segment; Windows device basenames and platform-invalid characters are forbidden.",
            "maxLength": 128,
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                {
                  "pattern": "^(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\u00b9\u00b2\u00b3]|[Ll][Pp][Tt][1-9\u00b9\u00b2\u00b3])(?:\\..*)?$"
                }
              ]
            },
            "pattern": "^[^\\x00-\\x1f\\x7f<>:\"/\\\\|?*]*[^\\x00-\\x1f\\x7f<>:\"/\\\\|?*. ]$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Relative Command",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "console_script",
        "reference",
        "relative_command"
      ],
      "title": "GatewayEntrypoint",
      "type": "object"
    },
    "StandaloneMcpEntrypoint": {
      "additionalProperties": false,
      "description": "The caller-owned standalone MCP launch surface.",
      "properties": {
        "kind": {
          "const": "standalone-mcp",
          "description": "The standalone MCP launch-surface discriminator.",
          "title": "Kind",
          "type": "string"
        },
        "console_script": {
          "description": "Console-script name declared by the distribution.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Console Script",
          "type": "string"
        },
        "reference": {
          "description": "Entry-point object reference, e.g. 'pkg.module:main'.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "relative_command": {
          "description": "Bounded argv path segments relative to the runtime root.",
          "items": {
            "description": "One portable, non-rooted runtime path segment; Windows device basenames and platform-invalid characters are forbidden.",
            "maxLength": 128,
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                {
                  "pattern": "^(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9\u00b9\u00b2\u00b3]|[Ll][Pp][Tt][1-9\u00b9\u00b2\u00b3])(?:\\..*)?$"
                }
              ]
            },
            "pattern": "^[^\\x00-\\x1f\\x7f<>:\"/\\\\|?*]*[^\\x00-\\x1f\\x7f<>:\"/\\\\|?*. ]$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Relative Command",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "console_script",
        "reference",
        "relative_command"
      ],
      "title": "StandaloneMcpEntrypoint",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The desktop component manifest consumed by the dashboard.\n\nThe manifest is the entire boundary the dashboard reads about an A2A\ngeneration: the component's identity and its typed launch surfaces. The\ndashboard owns build, versioning, snapshot, and rollback, so the manifest\ncarries no compatibility, bundled-asset, dependency-lock, or\nconsistency-group machinery.",
  "properties": {
    "identity": {
      "$ref": "#/$defs/ComponentIdentity",
      "description": "Component name and version."
    },
    "entrypoints": {
      "$ref": "#/$defs/ComponentEntrypoints",
      "description": "Gateway and standalone MCP launch surfaces."
    }
  },
  "required": [
    "identity",
    "entrypoints"
  ],
  "title": "ComponentManifest",
  "type": "object"
}
